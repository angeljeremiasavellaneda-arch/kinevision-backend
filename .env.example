# ════════════════════════════════════════════════════════════
#  KineVisión Backend — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  En Railway estas variables se configuran en el dashboard.
# ════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────
# Railway inyecta PORT automáticamente, no lo configures allí.
PORT=4000

# ── Supabase ─────────────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://kedsvrottxqsnnnnenjy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── Frontend (CORS) ───────────────────────────────────────────
# URL(s) del frontend permitidas. Separa con coma si hay varias.
# Ejemplo producción: https://kinevision.vercel.app
# Ejemplo dev+prod:   https://kinevision.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── n8n Webhook ──────────────────────────────────────────────
# URL del webhook de n8n que llama a Gemini.
# Modo producción (workflow activo): /webhook/kinevision
# Modo test (workflow abierto):      /webhook-test/kinevision
N8N_WEBHOOK_URL=https://angeljeremias.app.n8n.cloud/webhook/kinevision

# ── Seguridad webhook ─────────────────────────────────────────
# n8n envía este secreto al devolver los resultados de Gemini.
# Configura el mismo valor en el nodo HTTP de n8n como header:
#   x-webhook-secret: kinevision-secret-2026
WEBHOOK_SECRET=kinevision-secret-2026
